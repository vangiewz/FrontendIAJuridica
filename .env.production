# Configuración de PRODUCCIÓN (APK/AAB release). Solo valores PÚBLICOS: las variables EXPO_PUBLIC_* quedan
# escritas dentro de la app. Aquí nunca van contraseñas, claves ni secretos del backend.
EXPO_PUBLIC_USE_LOCAL_API=false
EXPO_PUBLIC_API_URL_CLOUD=https://ia-juridica-api.azurewebsites.net
EXPO_PUBLIC_API_URL_LOCAL=http://127.0.0.1:8000
# Usa el fetch de React Native en lugar de expo/fetch (el predeterminado de Expo 57). expo/fetch no
# admite archivos {uri, name, type} en FormData: sin esto falla toda subida de documentos en Android.
EXPO_PUBLIC_USE_RN_FETCH=true
