# URL del backend. NO es obligatoria en el celular: si no la defines, la app usa la IP
# de la PC desde la que Expo sirvió la app (la misma donde corre el backend) y el puerto 8000.
#
# Defínela solo si el backend está en otra máquina o en otro puerto. Copia este archivo
# como `.env` (que no se sube a git) y cambia la IP por la de tu PC:
#   Windows:  ipconfig   ->  «Dirección IPv4»
#
# EXPO_PUBLIC_API_URL=http://192.168.X.X:8000
#
# Web o navegador en la misma PC del backend:
# EXPO_PUBLIC_API_URL=http://localhost:8000
