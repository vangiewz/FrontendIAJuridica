# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Firma de release: rutas y contraseñas del keystore, propias de cada maquina.
android-release.properties
# Ruta del Android SDK, la escribe cada instalacion.
local.properties

# Metro
.metro-health-check*

# debug / logs
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# macOS
.DS_Store
*.pem

# Variables de entorno: NINGUNA se versiona, ni siquiera las de solo valores publicos.
# La unica variable de la app es EXPO_PUBLIC_API_URL, y esta documentada en el README:
#   - En Vercel se define en el panel del proyecto.
#   - En local, cada uno tiene su .env y comenta una linea u otra para elegir a que
#     backend apunta.
# Sin .env, la app va sola a produccion (o al host de Metro si esta corriendo `expo start`).
.env
.ENV
.env.*

# Python / virtual environments
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# Local AI models / large model files
ollama/
*.gguf
*.safetensors

# Si alguna vez existe una carpeta "models" SOLO en la raíz
# y contiene modelos pesados, ignorar únicamente esa:
#/models/

# TypeScript
*.tsbuildinfo

# generated native folders
/ios
/android

# Build artifacts
*.apk
*.aab

# Temporary / local files
tmp/
temp/
scratchpad/

# ---- Archivos de herramientas de IA / asistentes ----
.claude/
.impeccable/
.gemini/
.cursor/
.cline/

AGENTS.md
CLAUDE.md

# Documentos de trabajo: no se publican
DESIGN.md
PRODUCT.md
# Salida temporal de scripts/pruebas-logica.mjs. Vive dentro del repo porque el
# require de los modulos compilados tiene que resolver node_modules del proyecto.
.test-out-*/

# La configuración de producción solo tiene valores públicos: se versiona.
